@model vudominnhthanh_2310900099.Models.VdmtEmployee

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="container mt-5">
    <h2 class="mb-4">Edit Employee</h2>
    <div class="card shadow rounded">
        <div class="card-body">
            <form asp-action="VdmtEdit" method="post" onsubmit="return confirmSave();">
                <input type="hidden" asp-for="VdmtEmpId" />

                <div class="mb-3">
                    <label asp-for="VdmtEmpName" class="form-label"></label>
                    <input asp-for="VdmtEmpName" class="form-control" placeholder="Enter employee name" />
                    <span asp-validation-for="VdmtEmpName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="VdmtEmpLevel" class="form-label"></label>
                    <input asp-for="VdmtEmpLevel" class="form-control" placeholder="Level or title" />
                    <span asp-validation-for="VdmtEmpLevel" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="VdmtEmpStartDate" class="form-label"></label>
                    <input asp-for="VdmtEmpStartDate" class="form-control" type="date" />
                    <span asp-validation-for="VdmtEmpStartDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="VdmtEmpstatus" class="form-label">Status</label>
                    <select asp-for="VdmtEmpstatus" class="form-select">
                        <option value="1" selected="@((Model.VdmtEmpstatus == 1).ToString())">Show</option>
                        <option value="0" selected="@((Model.VdmtEmpstatus == 0).ToString())">Hide</option>
                    </select>
                    <span asp-validation-for="VdmtEmpstatus" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-center">
                    <button type="submit" class="btn btn-outline-primary">💾 Save Changes</button>
                </div>
            </form>
        </div>
    </div>
    <div class="mt-3 text-start">
        <a asp-action="VdmtIndex" class="btn btn-outline-success">⬅ Back to List</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function confirmSave() {
            return confirm("Bạn có chắc chắn muốn lưu thay đổi?");
        }
    </script>
}
