@model Vdmt_Ls10.Models.VdmtPost

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>VdmtPost</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.VdmtTitle)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.VdmtTitle)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.VdmtImage)
        </dt>
        <dd class = "col-sm-10">
            @if (!string.IsNullOrEmpty(Model.VdmtImage))
            {
                <img src="~/@Model.VdmtImage" alt="Ảnh bài viết" class="img-fluid rounded mb-3" />
            }
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.VdmtContent)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.VdmtContent)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.VdmtStatus)
        </dt>
        <dd class = "col-sm-10">
            @(Model.VdmtStatus == true ? "Hiển thị" : "Tạm khóa")
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Vdmtid" />
        <input type="submit" value="Delete" class="btn btn-danger" /> 
        <a asp-action="Index">Back to List</a>
    </form>
</div>
