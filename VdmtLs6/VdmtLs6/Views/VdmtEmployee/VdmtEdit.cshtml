@model VdmtLs6.Models.VdmtEmplyee

@{
    ViewData["Title"] = "Edit Employee";
}

<h2 class="mb-4">Edit Employee</h2>

<form asp-action="VdmtEdit" method="post" class="needs-validation" novalidate>
    <input type="hidden" asp-for="VdmtId" />
    <div class="row mb-3">
        <label asp-for="VdmtName" class="col-sm-2 col-form-label">Name</label>
        <div class="col-sm-10">
            <input asp-for="VdmtName" class="form-control" />
            <span asp-validation-for="VdmtName" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="VdmtBirthDay" class="col-sm-2 col-form-label">BirthDay</label>
        <div class="col-sm-10">
            <input asp-for="VdmtBirthDay" type="date" class="form-control" />
            <span asp-validation-for="VdmtBirthDay" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="VdmtEmail" class="col-sm-2 col-form-label">Email</label>
        <div class="col-sm-10">
            <input asp-for="VdmtEmail" type="email" class="form-control" />
            <span asp-validation-for="VdmtEmail" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="VdmtPhone" class="col-sm-2 col-form-label">Phone</label>
        <div class="col-sm-10">
            <input asp-for="VdmtPhone" type="number" class="form-control" />
            <span asp-validation-for="VdmtPhone" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="VdmtSalary" class="col-sm-2 col-form-label">Salary</label>
        <div class="col-sm-10">
            <input asp-for="VdmtSalary" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="VdmtSalary" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-sm-2">Status</div>
        <div class="col-sm-10 d-flex align-items-center">
            <div class="form-check">
                <input asp-for="VdmtStatus" class="form-check-input" type="checkbox" />
                <label class="form-check-label" asp-for="VdmtStatus">Active</label>
            </div>
            <span asp-validation-for="VdmtStatus" class="text-danger ms-2"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-10 offset-sm-2">
            <button type="submit" class="btn btn-primary">Update</button>
            <a asp-action="VdmtListEmployee" class="btn btn-secondary ms-2">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
